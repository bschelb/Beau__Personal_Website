---
import Layout from "../layouts/Layout.astro";

const links = [
  {
    label: "Email",
    value: "bschelbl@utk.edu",
    href: "mailto:bschelbl@utk.edu",
    desc: "Best method for research inquiries, collaboration, or student questions.",
    external: false,
  },
  {
    label: "LinkedIn",
    value: "linkedin.com/in/beau-schelble-ph-d",
    href: "https://www.linkedin.com/in/beau-schelble-ph-d-498675135/",
    desc: "Professional network and updates.",
    external: true,
  },
  {
    label: "Google Scholar",
    value: "Google Scholar Profile",
    href: "https://scholar.google.com",
    desc: "Complete publication list and citation metrics.",
    external: true,
  },
  {
    label: "ResearchGate",
    value: "ResearchGate Profile",
    href: "https://www.researchgate.net",
    desc: "Research profile and preprints.",
    external: true,
  },
  {
    label: "ARCS Lab",
    value: "arcslab.io",
    href: "https://arcslab.io",
    desc: "AI & Robotics for Collaborative Systems Lab website.",
    external: true,
  },
];

---

<Layout title="Contact" description="Contact Dr. Beau G. Schelble — Assistant Professor of ISE at the University of Tennessee, Knoxville.">
  <!-- ── Hero ── -->
  <section class="page-hero">
    <div class="container">
      <p class="section-label">Contact</p>
      <h1 class="section-title">Get in Touch</h1>
      <p class="section-desc">
        I welcome inquiries from prospective graduate students, collaborators, industry partners,
        and members of the press. Email is always the best way to reach me.
      </p>
    </div>
  </section>

  <!-- ── Contact grid ── -->
  <section class="section">
    <div class="container contact-grid">
      <!-- Left: Links -->
      <div>
        <p class="section-label">Contact &amp; Profiles</p>
        <div class="link-list">
          {links.map(link => (
            <a
              href={link.href}
              class="link-card"
              target={link.external ? "_blank" : "_self"}
              rel={link.external ? "noopener" : undefined}
            >
              <div class="link-label">{link.label}</div>
              <div class="link-value">{link.value}</div>
              <div class="link-desc">{link.desc}</div>
            </a>
          ))}
        </div>
      </div>

      <!-- Right: Office + ARCS -->
      <div>
        <p class="section-label">Office</p>
        <div class="card office-card">
          <div class="office-mark">
            <!-- Art deco diamond -->
            <svg viewBox="0 0 20 20" class="office-diamond" aria-hidden="true">
              <rect x="2" y="2" width="16" height="16" rx="1" transform="rotate(45 10 10)" fill="var(--vermillion)" opacity="0.15"/>
              <rect x="3.5" y="3.5" width="13" height="13" rx="0.5" transform="rotate(45 10 10)" fill="none" stroke="var(--gold)" stroke-width="0.75"/>
            </svg>
          </div>
          <h3 class="office-title">Dr. Beau G. Schelble</h3>
          <p class="office-role">Assistant Professor, Industrial &amp; Systems Engineering</p>

          <div class="office-detail">
            <span class="office-detail-icon">📍</span>
            <div>
              <p class="office-detail-label">Office</p>
              <p>Room 515, John D. Tickle Engineering Building</p>
              <p>851 Neyland Drive</p>
              <p>Knoxville, TN 37996</p>
            </div>
          </div>

          <div class="office-detail">
            <span class="office-detail-icon">✉️</span>
            <div>
              <p class="office-detail-label">Email</p>
              <a href="mailto:bschelbl@utk.edu" class="office-link">bschelbl@utk.edu</a>
            </div>
          </div>

          <div class="office-detail">
            <span class="office-detail-icon">🏛️</span>
            <div>
              <p class="office-detail-label">Department</p>
              <p>Industrial &amp; Systems Engineering</p>
              <p>Tickle College of Engineering</p>
              <p>University of Tennessee, Knoxville</p>
            </div>
          </div>
        </div>

        <div class="card arcs-card">
          <div class="arcs-header">
            <span class="arcs-icon">🤖</span>
            <div>
              <h3 class="arcs-title">ARCS Lab</h3>
              <p class="arcs-sub">AI &amp; Robotics for Collaborative Systems</p>
            </div>
          </div>
          <p class="arcs-desc">
            For inquiries about graduate positions or lab research, please also visit the ARCS Lab website.
          </p>
          <a href="https://arcslab.io" target="_blank" rel="noopener" class="btn btn-primary" style="margin-top:1rem;">
            Visit ARCS Lab ↗
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Talks link ── -->
  <section class="section section-earth">
    <div class="container talks-cta">
      <div>
        <p class="section-label">Talks &amp; Presentations</p>
        <h2 class="section-title" style="font-size:1.5rem;">Invited Lectures &amp; Conference Presentations</h2>
        <p class="section-desc" style="max-width:560px;">
          Seven invited talks at national labs, military institutions, and research universities —
          plus conference presentations and government program reviews. View the full list on the Talks page.
        </p>
      </div>
      <a href="/talks" class="btn btn-primary" style="flex-shrink:0;">View All Talks →</a>
    </div>
  </section>

  <!-- ── CTA ── -->
  <section class="section-vermillion">
    <div class="container cta-block">
      <div class="cta-text">
        <h2 class="cta-title">Prospective Ph.D. Students</h2>
        <p class="cta-desc">
          I am recruiting doctoral students with interest in human-AI teaming, trust, and cognitive
          systems engineering. Send a CV and brief statement of interest to get the conversation started.
        </p>
      </div>
      <a href="mailto:bschelbl@utk.edu?subject=Prospective%20PhD%20Student%20Inquiry" class="btn btn-outline-light">
        Email Me →
      </a>
    </div>
  </section>
</Layout>

<style>
  .page-hero {
    padding: 4rem 0 3rem;
    background: var(--light);
    border-bottom: 1px solid var(--border);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: 4rem;
    align-items: start;
  }

  /* Links */
  .link-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .link-card {
    display: block;
    padding: 1.1rem 1.4rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    text-decoration: none;
    transition: border-color 0.15s, box-shadow 0.15s, transform 0.15s;
    background: var(--cream);
    border-left: 3px solid var(--border);
  }

  .link-card:hover {
    border-left-color: var(--vermillion);
    box-shadow: 0 4px 16px -4px rgba(27,67,50,0.15);
    transform: translateX(2px);
  }

  .link-label {
    font-size: 0.65rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--gold);
    margin-bottom: 0.2rem;
  }

  .link-value {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--dark);
    margin-bottom: 0.2rem;
  }

  .link-desc {
    font-size: 0.78rem;
    color: var(--muted);
  }

  /* Office card */
  .office-card {
    padding: 1.75rem;
    margin-bottom: 1.25rem;
    position: relative;
    overflow: hidden;
  }

  .office-mark {
    position: absolute;
    top: 1rem;
    right: 1rem;
  }

  .office-diamond { width: 32px; height: 32px; }

  .office-title {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--dark);
    margin-bottom: 0.2rem;
  }

  .office-role {
    font-size: 0.82rem;
    color: var(--muted);
    margin-bottom: 1.25rem;
  }

  .office-detail {
    display: flex;
    gap: 0.875rem;
    margin-bottom: 1.1rem;
    align-items: flex-start;
  }

  .office-detail:last-child { margin-bottom: 0; }

  .office-detail-icon { font-size: 1rem; flex-shrink: 0; margin-top: 0.1rem; }

  .office-detail-label {
    font-size: 0.65rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--gold);
    margin-bottom: 0.25rem;
  }

  .office-detail p {
    font-size: 0.85rem;
    color: var(--mid);
    line-height: 1.6;
  }

  .office-link {
    font-size: 0.85rem;
    color: var(--vermillion);
    text-decoration: none;
    font-weight: 500;
  }

  .office-link:hover { text-decoration: underline; }

  /* ARCS card */
  .arcs-card { padding: 1.5rem; }

  .arcs-header {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    margin-bottom: 0.75rem;
  }

  .arcs-icon { font-size: 1.5rem; }

  .arcs-title {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    color: var(--dark);
    margin-bottom: 0.1rem;
  }

  .arcs-sub { font-size: 0.78rem; color: var(--muted); }

  .arcs-desc { font-size: 0.875rem; color: var(--mid); line-height: 1.65; }

  /* Talks section CTA */
  .talks-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2.5rem;
    flex-wrap: wrap;
  }

  /* CTA */
  .cta-block {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 3rem;
    flex-wrap: wrap;
  }

  .cta-text { flex: 1; min-width: 260px; }

  .cta-title {
    font-family: var(--font-display);
    font-size: 1.8rem;
    font-weight: 600;
    color: var(--cream);
    margin-bottom: 0.75rem;
  }

  .cta-desc {
    font-size: 0.95rem;
    color: rgba(255,249,244,0.8);
    line-height: 1.7;
  }

  @media (max-width: 900px) {
    .contact-grid { grid-template-columns: 1fr; gap: 2.5rem; }
  }

  @media (max-width: 768px) {
    .cta-block { flex-direction: column; }
    .talks-cta { flex-direction: column; }
  }
</style>
