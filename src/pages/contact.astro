---
import Layout from "../layouts/Layout.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const links = [
  {
    label: "Email",
    value: "bschelbl@utk.edu",
    href: "mailto:bschelbl@utk.edu",
    desc: "Best way to reach me for research inquiries, collaboration, or student questions.",
  },
  {
    label: "LinkedIn",
    value: "linkedin.com/in/beau-schelble-ph-d",
    href: "https://www.linkedin.com/in/beau-schelble-ph-d-498675135/",
    desc: "Professional network and updates.",
  },
  {
    label: "Google Scholar",
    value: "Google Scholar Profile",
    href: "https://scholar.google.com",
    desc: "Complete publication list and citation metrics.",
  },
  {
    label: "ResearchGate",
    value: "ResearchGate Profile",
    href: "https://www.researchgate.net",
    desc: "Research profile and preprints.",
  },
  {
    label: "ARCS Lab",
    value: "arcslab.io",
    href: "https://arcslab.io",
    desc: "AI & Robotics for Collaborative Systems Lab at UTK.",
  },
];
---

<Layout title="Contact" description="Contact Dr. Beau G. Schelble — Assistant Professor of ISE at the University of Tennessee, Knoxville.">
  <!-- ── Page hero ── -->
  <section class="page-hero">
    <div class="container">
      <p class="section-label">Contact</p>
      <h1 class="section-title">Get in Touch</h1>
      <p class="section-desc">
        I welcome inquiries from prospective graduate students, collaborators, industry partners,
        and members of the press. Email is the best way to reach me.
      </p>
    </div>
  </section>

  <!-- ── Contact ── -->
  <section class="section">
    <div class="container contact-grid">
      <!-- Left: Links -->
      <div>
        <p class="section-label">Contact &amp; Links</p>
        <div class="link-list">
          {links.map(link => (
            <a href={link.href} class="link-card" target={link.href.startsWith("mailto") ? "_self" : "_blank"} rel="noopener">
              <div class="link-label">{link.label}</div>
              <div class="link-value">{link.value}</div>
              <div class="link-desc">{link.desc}</div>
            </a>
          ))}
        </div>
      </div>

      <!-- Right: Location + Office -->
      <div>
        <p class="section-label">Office</p>
        <div class="card office-card">
          <h3 class="office-title">Dr. Beau G. Schelble</h3>
          <p class="office-role">Assistant Professor, Industrial &amp; Systems Engineering</p>
          <div class="office-detail">
            <span class="office-icon">📍</span>
            <div>
              <p class="office-detail-label">Office Location</p>
              <p>Room 515</p>
              <p>John D. Tickle Engineering Building</p>
              <p>851 Neyland Drive</p>
              <p>Knoxville, TN 37916</p>
            </div>
          </div>
          <div class="office-detail">
            <span class="office-icon">✉️</span>
            <div>
              <p class="office-detail-label">Email</p>
              <a href="mailto:bschelbl@utk.edu">bschelbl@utk.edu</a>
            </div>
          </div>
          <div class="office-detail">
            <span class="office-icon">🏛️</span>
            <div>
              <p class="office-detail-label">Department</p>
              <p>Industrial &amp; Systems Engineering</p>
              <p>Tickle College of Engineering</p>
              <p>University of Tennessee, Knoxville</p>
            </div>
          </div>
        </div>

        <div class="card arcs-card" style="margin-top:1.25rem;">
          <div class="arcs-header">
            <span class="arcs-icon">🤖</span>
            <div>
              <h3 class="arcs-title">ARCS Lab</h3>
              <p class="arcs-sub">AI &amp; Robotics for Collaborative Systems</p>
            </div>
          </div>
          <p class="arcs-desc">
            For inquiries about graduate positions, research opportunities, or lab collaborations,
            please also visit the ARCS Lab website.
          </p>
          <a href="https://arcslab.io" target="_blank" rel="noopener" class="btn btn-primary" style="margin-top:1rem; display:inline-flex;">
            Visit ARCS Lab ↗
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Prospective students ── -->
  <section class="section-orange">
    <div class="container cta-block">
      <div class="cta-text">
        <h2 class="cta-title">Prospective Graduate Students</h2>
        <p class="cta-desc">
          I am recruiting Ph.D. students with interest in human-AI teaming, trust, and cognitive
          systems engineering. If you are motivated, curious, and want to work on meaningful
          research at the intersection of humans and AI, please reach out with your CV and a
          brief statement of interest.
        </p>
      </div>
      <div class="cta-action">
        <a href="mailto:bschelbl@utk.edu?subject=Prospective%20PhD%20Student%20Inquiry" class="btn btn-outline-white">
          Email Me →
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-hero {
    padding: 4rem 0 3rem;
    background: var(--light);
    border-bottom: 1px solid var(--border);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: 4rem;
    align-items: start;
  }

  /* Links */
  .link-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .link-card {
    display: block;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--border);
    border-radius: 10px;
    text-decoration: none;
    transition: border-color 0.15s, box-shadow 0.15s, transform 0.15s;
    background: white;
  }

  .link-card:hover {
    border-color: var(--orange);
    box-shadow: 0 4px 16px -4px rgba(255,107,0,0.15);
    transform: translateY(-1px);
  }

  .link-label {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--orange);
    margin-bottom: 0.2rem;
  }

  .link-value {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--dark);
    margin-bottom: 0.2rem;
  }

  .link-desc {
    font-size: 0.8rem;
    color: var(--muted);
  }

  /* Office card */
  .office-card { padding: 1.75rem; }
  .office-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--dark);
    margin-bottom: 0.2rem;
  }

  .office-role {
    font-size: 0.825rem;
    color: var(--muted);
    margin-bottom: 1.25rem;
  }

  .office-detail {
    display: flex;
    gap: 0.875rem;
    margin-bottom: 1.25rem;
    align-items: flex-start;
  }

  .office-detail:last-child { margin-bottom: 0; }

  .office-icon { font-size: 1.1rem; flex-shrink: 0; margin-top: 0.05rem; }

  .office-detail-label {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--orange);
    margin-bottom: 0.25rem;
  }

  .office-detail p, .office-detail a {
    font-size: 0.875rem;
    color: var(--mid);
    line-height: 1.65;
    text-decoration: none;
  }

  .office-detail a { color: var(--orange); font-weight: 500; }
  .office-detail a:hover { text-decoration: underline; }

  /* ARCS card */
  .arcs-card { padding: 1.5rem; }

  .arcs-header {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    margin-bottom: 0.75rem;
  }

  .arcs-icon { font-size: 1.5rem; }

  .arcs-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--dark);
    margin-bottom: 0.1rem;
  }

  .arcs-sub {
    font-size: 0.78rem;
    color: var(--muted);
  }

  .arcs-desc {
    font-size: 0.875rem;
    color: var(--mid);
    line-height: 1.65;
  }

  /* CTA strip */
  .cta-block {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 3rem;
    flex-wrap: wrap;
  }

  .cta-text { flex: 1; min-width: 280px; }

  .cta-title {
    font-size: 1.6rem;
    font-weight: 800;
    color: white;
    letter-spacing: -0.03em;
    margin-bottom: 0.75rem;
  }

  .cta-desc {
    font-size: 0.95rem;
    color: rgba(255,255,255,0.82);
    line-height: 1.7;
  }

  .cta-action { flex-shrink: 0; }

  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }

  @media (max-width: 768px) {
    .cta-block { flex-direction: column; }
  }
</style>
