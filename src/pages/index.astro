---
import Layout from "../layouts/Layout.astro";
import publications from "../data/publications.json";

const recentPubs = [...publications]
  .filter(p => p.type === "journal" || p.type === "conference")
  .sort((a, b) => b.year - a.year)
  .slice(0, 5);

const researchAreas = [
  {
    num: "01",
    title: "Intelligent Information Sharing",
    desc: "Modeling how AI teammates should communicate within teams to optimize cognition, situational awareness, and decision quality.",
  },
  {
    num: "02",
    title: "Trustworthy AI",
    desc: "Designing transparent AI that calibrates trust appropriately, supports trust repair after violations, and integrates ethical norms.",
  },
  {
    num: "03",
    title: "Shared Mental Models",
    desc: "Understanding how humans and AI agents develop and leverage shared knowledge structures to improve coordinated team performance.",
  },
  {
    num: "04",
    title: "Situational Awareness",
    desc: "Investigating how AI presentation, spatial context, and teammate composition influence human perception, cognition, and decision-making.",
  },
  {
    num: "05",
    title: "Applied Human-AI Teaming",
    desc: "Translating teaming principles to manufacturing, cybersecurity, emergency response, and command and control.",
  },
  {
    num: "06",
    title: "Evaluation & Validation",
    desc: "Developing empirical methods and experimental paradigms to rigorously measure human-AI team performance, trust, and cognition.",
  },
];
---

<Layout title="Home">
  <!-- ── Hero ── -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-content fade-up">
        <p class="hero-eyebrow">Assistant Professor · Industrial &amp; Systems Engineering · UTK</p>
        <h1 class="hero-name">Dr. Beau G.<br/>Schelble</h1>
        <div class="hero-rule">
          <span></span><span class="hero-rule-diamond"></span><span></span>
        </div>
        <p class="hero-bio">
          For nearly a decade I have studied how humans and AI systems work together effectively.
          My research centers on <strong>human-AI teaming</strong>, <strong>trust calibration</strong>,
          and <strong>collaborative intelligent systems engineering</strong> — advancing both the
          fundamental science and practical design of AI teammates across high-stakes domains.
        </p>
        <p class="hero-bio">
          I direct the <a href="https://arcslab.io" target="_blank" rel="noopener" class="text-link">AI &amp; Robotics for Collaborative Systems (ARCS) Lab</a>
          at the University of Tennessee, Knoxville.
        </p>
        <div class="hero-actions">
          <a href="/publications" class="btn btn-primary">View Publications</a>
          <a href="/research" class="btn btn-outline">Research Areas</a>
          <a href="https://arcslab.io" target="_blank" rel="noopener" class="btn btn-outline">ARCS Lab ↗</a>
        </div>
      </div>

      <div class="hero-card fade-up" style="animation-delay:0.15s">
        <div class="profile-photo-wrap">
          <img src="/images/profile.jpg" alt="Dr. Beau G. Schelble" class="profile-photo" />
        </div>
        <div class="profile-info">
          <p class="profile-name">Beau G. Schelble, Ph.D.</p>
          <p class="profile-role">Assistant Professor, ISE</p>
          <p class="profile-uni">University of Tennessee, Knoxville</p>
          <div class="deco-rule">
            <span></span><span class="deco-rule-dot"></span><span></span>
          </div>
          <div class="profile-links">
            <a href="mailto:bschelbl@utk.edu">bschelbl@utk.edu</a>
            <a href="https://www.linkedin.com/in/beau-schelble-ph-d-498675135/" target="_blank" rel="noopener">LinkedIn</a>
            <a href="https://scholar.google.com" target="_blank" rel="noopener">Google Scholar</a>
            <a href="https://arcslab.io" target="_blank" rel="noopener">ARCS Lab</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Stats strip ── -->
  <section class="section-vermillion">
    <div class="container stats-grid">
      <div class="stat-item">
        <span class="stat-value">40+</span>
        <span class="stat-label">Publications</span>
      </div>
      <div class="stat-item">
        <span class="stat-value">$722K+</span>
        <span class="stat-label">Research Funding (PI)</span>
      </div>
      <div class="stat-item">
        <span class="stat-value">5</span>
        <span class="stat-label">Best Paper Awards</span>
      </div>
      <div class="stat-item">
        <span class="stat-value">2</span>
        <span class="stat-label">PhD Students</span>
      </div>
    </div>
  </section>

  <!-- ── Research areas ── -->
  <section class="section">
    <div class="container">
      <p class="section-label">01 — Research</p>
      <h2 class="section-title">Research Interests</h2>
      <p class="section-desc">
        My work spans the empirical and applied study of human-AI collaboration, drawing from
        human factors, cognitive engineering, and AI/autonomy systems.
      </p>
      <div class="research-grid">
        {researchAreas.map(area => (
          <div class="card research-card">
            <span class="research-num">{area.num}</span>
            <h3 class="research-title">{area.title}</h3>
            <p class="research-desc">{area.desc}</p>
          </div>
        ))}
      </div>
      <div style="margin-top:2.5rem;">
        <a href="/research" class="btn btn-outline">Explore Research →</a>
      </div>
    </div>
  </section>

  <!-- ── Recent publications ── -->
  <section class="section-dark">
    <div class="container">
      <p class="section-label">02 — Publications</p>
      <h2 class="section-title">Recent Work</h2>
      <p class="section-desc">Selected from 40+ publications in Human Factors, ACM, IEEE, and HCI venues.</p>
      <div class="pub-list">
        {recentPubs.map(pub => (
          <div class="pub-item">
            <div class="pub-meta">
              <span class="pub-year">{pub.year}</span>
              <span class={`pub-type ${pub.type}`}>{pub.type === "journal" ? "Journal" : "Conference"}</span>
              {pub.tags.map(tag => (
                <span class="pub-award">★ {tag}</span>
              ))}
              {pub.status === "in-press" && <span class="pub-status">In Press</span>}
            </div>
            <p class="pub-title">
              {pub.doi
                ? <a href={pub.doi} target="_blank" rel="noopener" class="pub-link">{pub.title}</a>
                : pub.title
              }
            </p>
            <p class="pub-venue">{pub.venue}</p>
            <p class="pub-authors">{pub.authors}</p>
          </div>
        ))}
      </div>
      <div style="margin-top:2.5rem;">
        <a href="/publications" class="btn btn-outline-light">View All Publications →</a>
      </div>
    </div>
  </section>

  <!-- ── About ── -->
  <section class="section section-earth">
    <div class="container bio-section">
      <div class="bio-text">
        <p class="section-label">03 — About</p>
        <h2 class="section-title">Background</h2>
        <p class="bio-para">
          I am an Assistant Professor of Industrial &amp; Systems Engineering at the University of
          Tennessee, Knoxville, and the founding director of the
          <a href="https://arcslab.io" target="_blank" rel="noopener" class="text-link">AI &amp; Robotics for Collaborative Systems (ARCS) Lab</a>.
        </p>
        <p class="bio-para">
          I received my Ph.D. in Human-Centered Computing from <strong>Clemson University</strong>
          in December 2023, where I was recognized as the Most Outstanding Graduate Student in the
          program. I also hold a B.S. in Psychology from Clemson (Summa Cum Laude, 2018).
        </p>
        <p class="bio-para">
          My work has been published in leading venues including <em>Human Factors</em>, <em>ACM CSCW</em>,
          <em>IEEE Transactions on Human-Machine Systems</em>, and <em>PNAS Nexus</em>, and has been
          recognized with five best paper awards across ACM GROUP, ACM HAI, HICSS, and JCEDM.
          I serve as Associate Editor for the <em>ASME Journal of Autonomous Vehicles and Systems</em>.
        </p>
        <div style="margin-top:1.75rem; display:flex; gap:1rem; flex-wrap:wrap;">
          <a href="/contact" class="btn btn-primary">Get in Touch</a>
          <a href="/publications" class="btn btn-outline">Publications</a>
        </div>
      </div>
      <div class="bio-highlights">
        <div class="highlight-item">
          <span class="highlight-icon">🎓</span>
          <div>
            <p class="highlight-label">Education</p>
            <p>Ph.D., Human-Centered Computing<br/>Clemson University, 2023</p>
            <p style="margin-top:0.25rem;">B.S., Psychology<br/>Clemson University, 2018</p>
          </div>
        </div>
        <div class="highlight-item">
          <span class="highlight-icon">🏛️</span>
          <div>
            <p class="highlight-label">Position</p>
            <p>Assistant Professor<br/>ISE, University of Tennessee, Knoxville<br/>(2024–present)</p>
          </div>
        </div>
        <div class="highlight-item">
          <span class="highlight-icon">🔬</span>
          <div>
            <p class="highlight-label">Lab</p>
            <p>Founding Director, ARCS Lab<br/><a href="https://arcslab.io" target="_blank" rel="noopener" class="text-link">arcslab.io</a></p>
          </div>
        </div>
        <div class="highlight-item">
          <span class="highlight-icon">📝</span>
          <div>
            <p class="highlight-label">Editorial Role</p>
            <p>Associate Editor<br/>ASME Journal of Autonomous Vehicles and Systems</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ── Hero ── */
  .hero {
    padding: 5rem 0 4rem;
    background: linear-gradient(160deg, var(--light) 0%, var(--cream) 100%);
    border-bottom: 1px solid var(--border);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 4.5rem;
    align-items: start;
  }

  .hero-eyebrow {
    font-size: 0.67rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--gold);
    margin-bottom: 1rem;
  }

  .hero-name {
    font-family: var(--font-display);
    font-size: 4rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--dark);
    line-height: 1.05;
    margin-bottom: 1.25rem;
  }

  /* Art deco rule under name */
  .hero-rule {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
    max-width: 280px;
  }

  .hero-rule span:not(.hero-rule-diamond) {
    flex: 1;
    height: 1px;
    background: linear-gradient(to right, var(--gold), transparent);
  }

  .hero-rule span:last-child {
    background: linear-gradient(to left, var(--gold), transparent);
  }

  .hero-rule-diamond {
    width: 6px;
    height: 6px;
    background: var(--gold);
    transform: rotate(45deg);
    flex: 0 !important;
  }

  .hero-bio {
    font-size: 1rem;
    color: var(--mid);
    line-height: 1.8;
    margin-bottom: 0.875rem;
    max-width: 560px;
  }

  .text-link {
    color: var(--vermillion);
    text-decoration: none;
    font-weight: 500;
    border-bottom: 1px solid rgba(197,51,32,0.3);
    transition: border-color 0.15s;
  }

  .text-link:hover { border-color: var(--vermillion); }

  .hero-actions {
    display: flex;
    gap: 0.75rem;
    margin-top: 2rem;
    flex-wrap: wrap;
  }

  /* Profile card */
  .hero-card {
    background: var(--cream);
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 4px 32px -8px rgba(28,15,9,0.12);
  }

  .profile-photo-wrap {
    width: 100%;
    aspect-ratio: 4/3;
    overflow: hidden;
    background: var(--light);
  }

  .profile-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
  }

  .profile-info {
    padding: 1.5rem;
    text-align: center;
  }

  .profile-name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.05rem;
    color: var(--dark);
    margin-bottom: 0.2rem;
  }

  .profile-role {
    font-size: 0.82rem;
    color: var(--muted);
    margin-bottom: 0.1rem;
  }

  .profile-uni {
    font-size: 0.78rem;
    color: var(--muted);
    margin-bottom: 0.75rem;
  }

  .deco-rule {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0.75rem 0;
  }

  .deco-rule span:not(.deco-rule-dot) {
    flex: 1;
    height: 1px;
    background: var(--border);
  }

  .deco-rule-dot {
    width: 5px;
    height: 5px;
    background: var(--gold);
    transform: rotate(45deg);
    flex: 0 !important;
  }

  .profile-links {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .profile-links a {
    font-size: 0.78rem;
    color: var(--vermillion);
    text-decoration: none;
    font-weight: 500;
    transition: color 0.15s;
  }

  .profile-links a:hover { color: var(--vermillion-dark); text-decoration: underline; }

  /* ── Stats ── */
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    text-align: center;
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 1.5rem 1rem;
    border-right: 1px solid rgba(255,249,244,0.2);
  }

  .stat-item:last-child { border-right: none; }

  .stat-value {
    font-family: var(--font-display);
    font-size: 2.8rem;
    font-weight: 600;
    color: var(--cream);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .stat-label {
    font-size: 0.7rem;
    font-weight: 600;
    color: rgba(255,249,244,0.65);
    margin-top: 0.4rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  /* ── Research cards ── */
  .research-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    margin-top: 2.5rem;
  }

  .research-card { border-left: 3px solid var(--vermillion); border-radius: 0 10px 10px 0; }

  .research-num {
    font-size: 0.65rem;
    font-weight: 700;
    color: var(--gold);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    display: block;
    margin-bottom: 0.6rem;
  }

  .research-title {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--dark);
    margin-bottom: 0.5rem;
    line-height: 1.25;
  }

  .research-desc {
    font-size: 0.85rem;
    color: var(--muted);
    line-height: 1.65;
  }

  /* ── Publications (dark) ── */
  .pub-list {
    margin-top: 2.5rem;
    display: flex;
    flex-direction: column;
  }

  .pub-item {
    padding: 1.5rem 0;
    border-bottom: 1px solid rgba(255,249,244,0.07);
  }

  .pub-item:first-child { border-top: 1px solid rgba(255,249,244,0.07); }

  .pub-meta {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin-bottom: 0.5rem;
    flex-wrap: wrap;
  }

  .pub-year {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--gold-light);
  }

  .pub-type {
    font-size: 0.67rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 0.15rem 0.45rem;
    border-radius: 3px;
  }

  .pub-type.journal { background: rgba(197,51,32,0.2); color: #F08070; }
  .pub-type.conference { background: rgba(139,94,60,0.2); color: #D4A87A; }

  .pub-award {
    font-size: 0.67rem;
    font-weight: 600;
    color: #E8C060;
    background: rgba(232,192,96,0.12);
    padding: 0.15rem 0.45rem;
    border-radius: 3px;
  }

  .pub-status {
    font-size: 0.67rem;
    font-weight: 600;
    color: rgba(255,249,244,0.45);
    background: rgba(255,249,244,0.06);
    padding: 0.15rem 0.45rem;
    border-radius: 3px;
    font-style: italic;
  }

  .pub-title {
    font-size: 0.95rem;
    font-weight: 500;
    color: rgba(255,249,244,0.9);
    line-height: 1.5;
    margin-bottom: 0.35rem;
  }

  .pub-link {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid rgba(255,249,244,0.2);
    transition: border-color 0.15s;
  }

  .pub-link:hover { border-color: var(--gold-light); color: var(--gold-light); }

  .pub-venue {
    font-size: 0.82rem;
    color: rgba(255,249,244,0.45);
    font-style: italic;
    margin-bottom: 0.25rem;
  }

  .pub-authors {
    font-size: 0.78rem;
    color: rgba(255,249,244,0.3);
  }

  /* ── About/Bio ── */
  .bio-section {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 5rem;
    align-items: start;
  }

  .bio-para {
    font-size: 1rem;
    color: var(--mid);
    line-height: 1.8;
    margin-bottom: 1rem;
  }

  .bio-highlights {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .highlight-item {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--cream);
  }

  .highlight-icon { font-size: 1.1rem; flex-shrink: 0; }

  .highlight-label {
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--gold);
    margin-bottom: 0.3rem;
  }

  .highlight-item p {
    font-size: 0.85rem;
    color: var(--mid);
    line-height: 1.55;
  }

  /* ── Responsive ── */
  @media (max-width: 1024px) {
    .research-grid { grid-template-columns: repeat(2, 1fr); }
    .stats-grid { grid-template-columns: repeat(2, 1fr); }
    .stat-item { border-bottom: 1px solid rgba(255,249,244,0.15); }
  }

  @media (max-width: 768px) {
    .hero-grid { grid-template-columns: 1fr; gap: 2.5rem; }
    .hero-card { order: -1; max-width: 280px; margin: 0 auto; }
    .hero-name { font-size: 2.8rem; }
    .research-grid { grid-template-columns: 1fr; }
    .bio-section { grid-template-columns: 1fr; gap: 2.5rem; }
    .stats-grid { grid-template-columns: 1fr 1fr; }
  }
</style>
