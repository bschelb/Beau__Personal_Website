---
import Layout from "../layouts/Layout.astro";
import publications from "../data/publications.json";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const recentPubs = [...publications]
  .sort((a, b) => b.year - a.year)
  .slice(0, 5);

const researchAreas = [
  {
    num: "01",
    title: "Intelligent Information Sharing",
    desc: "Modeling how information should be communicated within human-AI teams to optimize team cognition, situational awareness, and decision quality.",
  },
  {
    num: "02",
    title: "Trustworthy AI",
    desc: "Designing transparent AI behaviors that calibrate trust appropriately, support trust repair after violations, and integrate ethical considerations into teaming.",
  },
  {
    num: "03",
    title: "Shared Mental Models",
    desc: "Understanding how humans and AI agents develop, maintain, and leverage shared knowledge structures to improve coordinated team performance.",
  },
  {
    num: "04",
    title: "Situational Awareness",
    desc: "Investigating how team composition, AI presentation, and spatial information influence human perception, cognition, and situational understanding.",
  },
  {
    num: "05",
    title: "Applied Human-AI Teaming",
    desc: "Translating human-AI teaming principles to real-world domains including manufacturing, cybersecurity, emergency response, and command and control.",
  },
  {
    num: "06",
    title: "Evaluation & Validation",
    desc: "Developing empirical methods and experimental paradigms to rigorously measure human-AI team performance, trust, and collaborative cognition.",
  },
];

const stats = [
  { value: "35+", label: "Publications" },
  { value: "$722K+", label: "Research Funding (PI)" },
  { value: "5", label: "Best Paper Awards" },
];
---

<Layout title="Home">
  <!-- ── Hero ── -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-content fade-up">
        <p class="hero-eyebrow">Assistant Professor · Industrial &amp; Systems Engineering</p>
        <h1 class="hero-name">Dr. Beau G. Schelble</h1>
        <p class="hero-bio">
          I study how humans and AI systems work together effectively. My research focuses on
          <strong>human-AI teaming</strong>, <strong>trust calibration</strong>, and
          <strong>collaborative intelligent systems</strong> — advancing the science of how we design
          AI teammates that are trustworthy, transparent, and beneficial across high-stakes domains.
        </p>
        <p class="hero-bio hero-bio-sm">
          Based at the University of Tennessee, Knoxville, I direct the
          <a href="https://arcslab.io" target="_blank" rel="noopener" class="hero-link">AI &amp; Robotics for Collaborative Systems (ARCS) Lab</a>.
        </p>
        <div class="hero-actions">
          <a href={`${base}/publications`} class="btn btn-primary">View Publications</a>
          <a href={`${base}/research`} class="btn btn-outline">Research Areas</a>
          <a href="https://arcslab.io" target="_blank" rel="noopener" class="btn btn-outline">ARCS Lab ↗</a>
        </div>
      </div>
      <div class="hero-card fade-up" style="animation-delay:0.15s">
        <div class="profile-photo">
          <div class="profile-initials">BGS</div>
        </div>
        <div class="profile-info">
          <p class="profile-name">Beau G. Schelble, Ph.D.</p>
          <p class="profile-role">Assistant Professor, ISE</p>
          <p class="profile-uni">University of Tennessee, Knoxville</p>
          <div class="profile-links">
            <a href="mailto:bschelbl@utk.edu">bschelbl@utk.edu</a>
            <a href="https://www.linkedin.com/in/beau-schelble-ph-d-498675135/" target="_blank" rel="noopener">LinkedIn</a>
            <a href="https://arcslab.io" target="_blank" rel="noopener">ARCS Lab</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Stats strip ── -->
  <section class="section-orange">
    <div class="container stats-grid">
      {stats.map(s => (
        <div class="stat-item">
          <span class="stat-value">{s.value}</span>
          <span class="stat-label">{s.label}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- ── Research areas ── -->
  <section class="section">
    <div class="container">
      <p class="section-label">01 — Research</p>
      <h2 class="section-title">Research Interests</h2>
      <p class="section-desc">
        My work spans the empirical and applied study of human-AI collaboration, drawing from
        human factors, cognitive engineering, and AI/autonomy systems.
      </p>
      <div class="research-grid">
        {researchAreas.map(area => (
          <div class="card research-card">
            <span class="research-num">{area.num}</span>
            <h3 class="research-title">{area.title}</h3>
            <p class="research-desc">{area.desc}</p>
          </div>
        ))}
      </div>
      <div style="margin-top:2.5rem;">
        <a href={`${base}/research`} class="btn btn-outline">Explore Research →</a>
      </div>
    </div>
  </section>

  <!-- ── Recent publications ── -->
  <section class="section-dark">
    <div class="container">
      <p class="section-label">02 — Publications</p>
      <h2 class="section-title">Recent Work</h2>
      <p class="section-desc">Selected publications in human factors, HCI, and AI teaming.</p>
      <div class="pub-list">
        {recentPubs.map(pub => (
          <div class="pub-item">
            <div class="pub-meta">
              <span class="pub-year">{pub.year}</span>
              <span class="pub-type">{pub.type === "journal" ? "Journal" : "Conference"}</span>
              {pub.tags.map(tag => (
                <span class="pub-award">★ {tag}</span>
              ))}
            </div>
            <p class="pub-title">{pub.title}</p>
            <p class="pub-venue">{pub.venue}</p>
            <p class="pub-authors">{pub.authors}</p>
          </div>
        ))}
      </div>
      <div style="margin-top:2.5rem;">
        <a href={`${base}/publications`} class="btn btn-outline-white">View All Publications →</a>
      </div>
    </div>
  </section>

  <!-- ── Bio/background strip ── -->
  <section class="section">
    <div class="container bio-section">
      <div class="bio-text">
        <p class="section-label">03 — Background</p>
        <h2 class="section-title">About Me</h2>
        <p class="bio-para">
          I am an Assistant Professor of Industrial &amp; Systems Engineering at the University of
          Tennessee, Knoxville, where I founded the
          <a href="https://arcslab.io" target="_blank" rel="noopener">AI &amp; Robotics for Collaborative Systems (ARCS) Lab</a>.
        </p>
        <p class="bio-para">
          I earned my Ph.D. in Human-Centered Computing from <strong>Clemson University</strong> in
          2023, focusing on human-AI teaming, team cognition, and collaborative intelligent systems
          design. My dissertation and subsequent work explore how teams of humans and AI agents can
          be engineered to perform safely and effectively.
        </p>
        <p class="bio-para">
          In addition to research, I serve as Associate Editor for the
          <em>ASME Journal of Autonomous Vehicles and Systems</em> and regularly publish in leading
          venues including Human Factors, ACM CSCW, IEEE Transactions on Human-Machine Systems,
          and HFES.
        </p>
        <div style="margin-top:1.75rem; display:flex; gap:1rem; flex-wrap:wrap;">
          <a href={`${base}/contact`} class="btn btn-primary">Get in Touch</a>
          <a href={`${base}/publications`} class="btn btn-outline">Publications</a>
        </div>
      </div>
      <div class="bio-highlights">
        <div class="highlight-item">
          <span class="highlight-icon">🎓</span>
          <div>
            <p class="highlight-label">Education</p>
            <p>Ph.D., Human-Centered Computing<br />Clemson University, 2023</p>
          </div>
        </div>
        <div class="highlight-item">
          <span class="highlight-icon">🏛️</span>
          <div>
            <p class="highlight-label">Position</p>
            <p>Assistant Professor<br />ISE, University of Tennessee, Knoxville</p>
          </div>
        </div>
        <div class="highlight-item">
          <span class="highlight-icon">🔬</span>
          <div>
            <p class="highlight-label">Lab</p>
            <p>Director, ARCS Lab<br /><a href="https://arcslab.io" target="_blank" rel="noopener">arcslab.io</a></p>
          </div>
        </div>
        <div class="highlight-item">
          <span class="highlight-icon">📝</span>
          <div>
            <p class="highlight-label">Editorial Role</p>
            <p>Associate Editor<br />ASME Journal of Autonomous Vehicles and Systems</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ── Hero ── */
  .hero {
    padding: 5rem 0 4rem;
    background: linear-gradient(to bottom, var(--light) 0%, var(--white) 100%);
    border-bottom: 1px solid var(--border);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 4rem;
    align-items: start;
  }

  .hero-eyebrow {
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--orange);
    margin-bottom: 1rem;
  }

  .hero-name {
    font-size: 3rem;
    font-weight: 800;
    letter-spacing: -0.04em;
    color: var(--dark);
    line-height: 1.1;
    margin-bottom: 1.25rem;
  }

  .hero-bio {
    font-size: 1.05rem;
    color: var(--mid);
    line-height: 1.75;
    margin-bottom: 0.75rem;
    max-width: 580px;
  }

  .hero-bio-sm { margin-top: 0; }

  .hero-link {
    color: var(--orange);
    text-decoration: none;
    font-weight: 600;
  }

  .hero-link:hover { text-decoration: underline; }

  .hero-actions {
    display: flex;
    gap: 0.75rem;
    margin-top: 2rem;
    flex-wrap: wrap;
  }

  /* Profile card */
  .hero-card {
    background: white;
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 2rem;
    box-shadow: 0 4px 24px -8px rgba(0,0,0,0.1);
    text-align: center;
  }

  .profile-photo {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--orange) 0%, #ff9a00 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.25rem;
  }

  .profile-initials {
    color: white;
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: 0.05em;
  }

  .profile-name {
    font-weight: 700;
    font-size: 1rem;
    color: var(--dark);
    margin-bottom: 0.25rem;
  }

  .profile-role {
    font-size: 0.875rem;
    color: var(--muted);
    margin-bottom: 0.1rem;
  }

  .profile-uni {
    font-size: 0.8rem;
    color: var(--muted);
    margin-bottom: 1.25rem;
  }

  .profile-links {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .profile-links a {
    font-size: 0.8rem;
    color: var(--orange);
    text-decoration: none;
    font-weight: 500;
  }

  .profile-links a:hover { text-decoration: underline; }

  /* ── Stats ── */
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    text-align: center;
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 1.5rem;
    border-right: 1px solid rgba(255,255,255,0.25);
  }

  .stat-item:last-child { border-right: none; }

  .stat-value {
    font-size: 2.5rem;
    font-weight: 800;
    letter-spacing: -0.04em;
    color: white;
    line-height: 1;
  }

  .stat-label {
    font-size: 0.8rem;
    font-weight: 500;
    color: rgba(255,255,255,0.75);
    margin-top: 0.375rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  /* ── Research ── */
  .research-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    margin-top: 2.5rem;
  }

  .research-card { position: relative; }

  .research-num {
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--orange);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    display: block;
    margin-bottom: 0.75rem;
  }

  .research-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--dark);
    margin-bottom: 0.5rem;
    line-height: 1.3;
  }

  .research-desc {
    font-size: 0.875rem;
    color: var(--muted);
    line-height: 1.65;
  }

  /* ── Publications ── */
  .pub-list {
    margin-top: 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .pub-item {
    padding: 1.5rem 0;
    border-bottom: 1px solid rgba(255,255,255,0.08);
  }

  .pub-item:first-child { border-top: 1px solid rgba(255,255,255,0.08); }

  .pub-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
    flex-wrap: wrap;
  }

  .pub-year {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--orange);
  }

  .pub-type {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: rgba(255,255,255,0.35);
    background: rgba(255,255,255,0.06);
    padding: 0.1rem 0.5rem;
    border-radius: 4px;
  }

  .pub-award {
    font-size: 0.7rem;
    font-weight: 600;
    color: #fbbf24;
    background: rgba(251,191,36,0.12);
    padding: 0.1rem 0.5rem;
    border-radius: 4px;
  }

  .pub-title {
    font-size: 0.975rem;
    font-weight: 600;
    color: white;
    line-height: 1.5;
    margin-bottom: 0.35rem;
  }

  .pub-venue {
    font-size: 0.825rem;
    color: rgba(255,255,255,0.5);
    font-style: italic;
    margin-bottom: 0.25rem;
  }

  .pub-authors {
    font-size: 0.8rem;
    color: rgba(255,255,255,0.35);
  }

  /* ── Bio section ── */
  .bio-section {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 5rem;
    align-items: start;
  }

  .bio-para {
    font-size: 1rem;
    color: var(--mid);
    line-height: 1.8;
    margin-bottom: 1rem;
  }

  .bio-para a {
    color: var(--orange);
    text-decoration: none;
    font-weight: 500;
  }

  .bio-para a:hover { text-decoration: underline; }

  .bio-highlights {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .highlight-item {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--light);
  }

  .highlight-icon { font-size: 1.25rem; flex-shrink: 0; }

  .highlight-label {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--orange);
    margin-bottom: 0.25rem;
  }

  .highlight-item p {
    font-size: 0.875rem;
    color: var(--mid);
    line-height: 1.5;
  }

  .highlight-item a {
    color: var(--orange);
    text-decoration: none;
    font-weight: 500;
  }

  /* ── Responsive ── */
  @media (max-width: 1024px) {
    .research-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 768px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .hero-card { order: -1; max-width: 300px; margin: 0 auto; }

    .hero-name { font-size: 2.2rem; }

    .stats-grid { grid-template-columns: 1fr; }
    .stat-item { border-right: none; border-bottom: 1px solid rgba(255,255,255,0.2); }
    .stat-item:last-child { border-bottom: none; }

    .research-grid { grid-template-columns: 1fr; }

    .bio-section { grid-template-columns: 1fr; gap: 2.5rem; }
  }
</style>
