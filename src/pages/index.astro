---
import Layout from "../layouts/Layout.astro";
import publications from "../data/publications.json";

const recentPubs = [...publications]
  .filter(p => p.type === "journal" || p.type === "conference")
  .sort((a, b) => b.year - a.year)
  .slice(0, 5);

const researchAreas = [
  { num: "01", title: "Intelligent Information Sharing", desc: "Modeling how AI teammates should communicate within teams to optimize cognition, situational awareness, and decision quality." },
  { num: "02", title: "Trustworthy AI", desc: "Designing transparent AI that calibrates trust appropriately, supports trust repair, and integrates ethical norms." },
  { num: "03", title: "Shared Mental Models", desc: "Understanding how humans and AI develop shared knowledge structures for coordinated team performance." },
  { num: "04", title: "Situational Awareness", desc: "Investigating how AI presentation and teammate composition influence human perception and decision-making." },
  { num: "05", title: "Applied Human-AI Teaming", desc: "Translating teaming principles to manufacturing, cybersecurity, emergency response, and command and control." },
  { num: "06", title: "Evaluation & Validation", desc: "Developing empirical methods and experimental paradigms to measure human-AI team performance and trust." },
];
---

<Layout title="Home">

  <!-- ── Hero ── -->
  <section class="hero">
    <div class="container hero-inner">

      <div class="hero-text fade-up">
        <p class="hero-eyebrow">Human-AI Teaming · ISE · University of Tennessee</p>
        <h1 class="hero-name">Beau G.<br/>Schelble</h1>
        <p class="hero-degree">Ph.D. · Assistant Professor</p>
        <p class="hero-bio">
          For nearly a decade I have studied how humans and AI systems work together
          effectively. My research advances the science of <strong>human-AI teaming</strong> —
          investigating trust, communication, shared mental models, and collaborative
          intelligence across high-stakes real-world domains.
        </p>
        <p class="hero-bio" style="margin-top:0.625rem;">
          I direct the <a href="https://arcslab.io" target="_blank" rel="noopener" class="inline-link">AI &amp; Robotics for Collaborative Systems (ARCS) Lab</a> at UTK.
        </p>
        <div class="hero-actions">
          <a href="/publications" class="btn btn-primary">Publications</a>
          <a href="/research" class="btn btn-outline">Research Areas</a>
          <a href="/contact" class="btn btn-outline">Contact</a>
        </div>
      </div>

      <div class="hero-photo-col fade-up" style="animation-delay:0.12s">
        <img
          src="/images/profile.jpg"
          alt="Dr. Beau G. Schelble"
          class="hero-photo"
        />
        <p class="hero-photo-caption">
          <span class="caption-name">Beau G. Schelble, Ph.D.</span>
          <span class="caption-sep"> · </span>
          <span>Assistant Professor, ISE · UTK</span>
        </p>
      </div>

    </div>
  </section>

  <!-- ── Stats strip ── -->
  <div class="stats-strip">
    <div class="container stats-grid">
      <div class="stat-item">
        <span class="stat-val">40+</span>
        <span class="stat-lbl">Peer-Reviewed Works</span>
      </div>
      <div class="stat-sep"></div>
      <div class="stat-item">
        <span class="stat-val">$722K</span>
        <span class="stat-lbl">Research Funding (PI)</span>
      </div>
      <div class="stat-sep"></div>
      <div class="stat-item">
        <span class="stat-val">5</span>
        <span class="stat-lbl">Best Paper Awards</span>
      </div>
      <div class="stat-sep"></div>
      <div class="stat-item">
        <span class="stat-val">4</span>
        <span class="stat-lbl">Graduate Students</span>
      </div>
    </div>
  </div>

  <!-- ── Research areas — editorial table layout ── -->
  <section class="section">
    <div class="container">
      <div class="research-hd">
        <div>
          <p class="section-label">Research</p>
          <h2 class="section-title">Core Focus Areas</h2>
        </div>
        <a href="/research" class="btn btn-outline">Full Overview →</a>
      </div>
      <div class="research-list">
        {researchAreas.map(area => (
          <div class="research-row">
            <span class="rn">{area.num}</span>
            <h3 class="rt">{area.title}</h3>
            <p class="rd">{area.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Recent publications ── -->
  <section class="section-dark">
    <div class="container">
      <div class="pubs-hd">
        <div>
          <p class="section-label">Publications</p>
          <h2 class="section-title">Recent Work</h2>
        </div>
        <a href="/publications" class="btn btn-outline-light">View All →</a>
      </div>
      <div class="pubs-list">
        {recentPubs.map(pub => (
          <div class="pub-row">
            <div class="pub-meta">
              <span class="pub-yr">{pub.year}</span>
              <span class={`pub-type ${pub.type}`}>{pub.type === "journal" ? "J" : "C"}</span>
              {pub.tags.length > 0 && <span class="pub-star">★</span>}
            </div>
            <div class="pub-body">
              {pub.doi
                ? <a href={pub.doi} target="_blank" rel="noopener" class="pub-title">{pub.title}</a>
                : <p class="pub-title">{pub.title}</p>
              }
              <p class="pub-venue">{pub.venue}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── About ── -->
  <section class="section section-earth">
    <div class="container about-grid">
      <div class="about-text">
        <p class="section-label">About</p>
        <h2 class="section-title" style="font-size:2rem;">Background</h2>
        <p class="about-para">
          I am an Assistant Professor of ISE at the University of Tennessee, Knoxville,
          and founding director of the
          <a href="https://arcslab.io" target="_blank" rel="noopener" class="inline-link">AI &amp; Robotics for Collaborative Systems (ARCS) Lab</a>.
          I received my Ph.D. in Human-Centered Computing from Clemson University (2023),
          where I was named the Most Outstanding Graduate Student.
        </p>
        <p class="about-para">
          My work appears in <em>Human Factors</em>, <em>ACM CSCW</em>, <em>IEEE Transactions
          on Human-Machine Systems</em>, and <em>PNAS Nexus</em>, and has been recognized with
          five best paper awards across ACM GROUP, ACM HAI, HICSS, and JCEDM. I serve as
          Associate Editor, <em>ASME Journal of Autonomous Vehicles and Systems</em>.
        </p>
        <div class="about-actions">
          <a href="/contact" class="btn btn-primary">Get in Touch</a>
          <a href="/research" class="btn btn-outline">Research Overview</a>
        </div>
      </div>
      <div class="about-facts">
        <div class="fact-row">
          <p class="fact-lbl">Position</p>
          <p>Assistant Professor, ISE<br/>University of Tennessee, Knoxville<br/><span class="fact-yr">2024–present</span></p>
        </div>
        <div class="fact-row">
          <p class="fact-lbl">Ph.D.</p>
          <p>Human-Centered Computing<br/>Clemson University, 2023</p>
        </div>
        <div class="fact-row">
          <p class="fact-lbl">B.S.</p>
          <p>Psychology, Summa Cum Laude<br/>Clemson University, 2018</p>
        </div>
        <div class="fact-row">
          <p class="fact-lbl">Lab</p>
          <p>Founding Director, ARCS Lab<br/><a href="https://arcslab.io" target="_blank" rel="noopener" class="inline-link">arcslab.io</a></p>
        </div>
        <div class="fact-row">
          <p class="fact-lbl">Editorial</p>
          <p>Associate Editor<br/>ASME Journal of Autonomous Vehicles and Systems</p>
        </div>
      </div>
    </div>
  </section>

</Layout>

<style>
/* ── Hero ── */
.hero {
  padding: 5.5rem 0 5rem;
  background: var(--light);
  border-bottom: 1px solid var(--border);
}

.hero-inner {
  display: grid;
  grid-template-columns: 1fr 340px;
  gap: 5rem;
  align-items: center;
}

.hero-eyebrow {
  font-size: 0.63rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.22em;
  color: var(--gold);
  margin-bottom: 1.25rem;
}

.hero-name {
  font-family: var(--font-display);
  font-size: 5.5rem;
  font-weight: 600;
  letter-spacing: -0.03em;
  color: var(--dark);
  line-height: 0.95;
  margin-bottom: 0.75rem;
}

.hero-degree {
  font-size: 0.78rem;
  color: var(--muted);
  letter-spacing: 0.12em;
  margin-bottom: 1.75rem;
  font-weight: 500;
  text-transform: uppercase;
}

.hero-bio {
  font-size: 1.05rem;
  color: var(--mid);
  line-height: 1.8;
  max-width: 520px;
}

.inline-link {
  color: var(--vermillion);
  text-decoration: none;
  font-weight: 500;
  border-bottom: 1px solid rgba(27,67,50,0.3);
  transition: border-color 0.15s;
}

.inline-link:hover { border-color: var(--vermillion); }

.hero-actions {
  display: flex;
  gap: 0.75rem;
  margin-top: 2.25rem;
  flex-wrap: wrap;
}

/* Photo — portrait format, art deco offset shadow */
.hero-photo-col {
  padding-right: 14px;
  padding-bottom: 14px;
}

.hero-photo {
  display: block;
  width: 100%;
  height: 460px;
  object-fit: cover;
  object-position: center 15%;
  border: 1px solid rgba(226,207,188,0.8);
  box-shadow: 14px 14px 0 rgba(184,136,58,0.2);
}

.hero-photo-caption {
  font-size: 0.75rem;
  color: var(--muted);
  margin-top: 0.875rem;
  padding-right: 14px;
}

.caption-name { font-weight: 600; color: var(--mid); }

/* ── Stats strip ── */
.stats-strip {
  background: var(--dark);
  border-top: 2px solid var(--vermillion);
}

.stats-grid {
  display: flex;
  align-items: stretch;
  padding-top: 2rem;
  padding-bottom: 2rem;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.stat-val {
  font-family: var(--font-display);
  font-size: 2.6rem;
  font-weight: 600;
  color: var(--cream);
  line-height: 1;
  letter-spacing: -0.02em;
}

.stat-lbl {
  font-size: 0.67rem;
  font-weight: 600;
  color: rgba(255,249,244,0.42);
  margin-top: 0.35rem;
  text-transform: uppercase;
  letter-spacing: 0.1em;
}

.stat-sep {
  width: 1px;
  background: rgba(255,249,244,0.09);
  margin: 0.5rem 0;
  flex-shrink: 0;
}

/* ── Research — editorial table ── */
.research-hd {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding-bottom: 1.5rem;
  border-bottom: 1px solid var(--border);
  flex-wrap: wrap;
  gap: 1rem;
}

.research-list { display: flex; flex-direction: column; }

.research-row {
  display: grid;
  grid-template-columns: 3.5ch 1fr 2fr;
  gap: 2.5rem;
  align-items: baseline;
  padding: 1.5rem 0;
  border-bottom: 1px solid var(--border);
}

.rn {
  font-size: 0.62rem;
  font-weight: 800;
  color: var(--gold);
  letter-spacing: 0.15em;
  font-variant-numeric: tabular-nums;
}

.rt {
  font-family: var(--font-display);
  font-size: 1.15rem;
  font-weight: 600;
  color: var(--dark);
  line-height: 1.2;
}

.rd {
  font-size: 0.875rem;
  color: var(--muted);
  line-height: 1.65;
}

/* ── Publications ── */
.pubs-hd {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 2.5rem;
  flex-wrap: wrap;
  gap: 1rem;
}

.pubs-list { display: flex; flex-direction: column; }

.pub-row {
  display: grid;
  grid-template-columns: 70px 1fr;
  gap: 1.75rem;
  padding: 1.5rem 0;
  border-bottom: 1px solid rgba(255,249,244,0.07);
  align-items: start;
}

.pub-row:first-child { border-top: 1px solid rgba(255,249,244,0.07); }

.pub-meta {
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
  padding-top: 0.15rem;
}

.pub-yr {
  font-size: 0.72rem;
  font-weight: 700;
  color: var(--gold-light);
}

.pub-type {
  font-size: 0.62rem;
  font-weight: 800;
  padding: 0.15rem 0.4rem;
  border-radius: 2px;
  letter-spacing: 0.05em;
  display: inline-block;
}

.pub-type.journal { background: rgba(27,67,50,0.28); color: #7EC4A4; }
.pub-type.conference { background: rgba(139,94,60,0.2); color: #D4A87A; }

.pub-star { font-size: 0.7rem; color: #E8C060; }

.pub-title {
  font-size: 0.935rem;
  font-weight: 500;
  color: rgba(255,249,244,0.88);
  line-height: 1.52;
  margin-bottom: 0.4rem;
  display: block;
  text-decoration: none;
  transition: color 0.15s;
}

a.pub-title:hover { color: var(--gold-light); }

.pub-venue {
  font-size: 0.8rem;
  color: rgba(255,249,244,0.35);
  font-style: italic;
}

/* ── About ── */
.about-grid {
  display: grid;
  grid-template-columns: 1fr 300px;
  gap: 5rem;
  align-items: start;
}

.about-para {
  font-size: 0.975rem;
  color: var(--mid);
  line-height: 1.82;
  margin-bottom: 1rem;
}

.about-actions {
  margin-top: 1.75rem;
  display: flex;
  gap: 0.75rem;
  flex-wrap: wrap;
}

.about-facts { display: flex; flex-direction: column; }

.fact-row {
  padding: 1rem 0;
  border-bottom: 1px solid var(--border);
}

.fact-row:first-child { border-top: 1px solid var(--border); }

.fact-lbl {
  font-size: 0.62rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.2em;
  color: var(--gold);
  margin-bottom: 0.35rem;
}

.fact-row p {
  font-size: 0.875rem;
  color: var(--mid);
  line-height: 1.6;
}

.fact-yr { color: var(--earth); font-weight: 500; font-size: 0.82rem; }

/* ── Responsive ── */
@media (max-width: 1024px) {
  .hero-name { font-size: 4.5rem; }
  .hero-inner { grid-template-columns: 1fr 300px; gap: 3.5rem; }
  .research-row { grid-template-columns: 3.5ch 160px 1fr; gap: 2rem; }
}

@media (max-width: 768px) {
  .hero { padding: 3.5rem 0; }
  .hero-inner { grid-template-columns: 1fr; gap: 2.5rem; }
  .hero-photo-col { order: -1; padding-right: 0; padding-bottom: 0; }
  .hero-photo { height: 300px; box-shadow: none; }
  .hero-name { font-size: 3.5rem; }
  .stats-grid { flex-wrap: wrap; }
  .stat-sep { display: none; }
  .stat-item { flex: 1 0 40%; padding: 0.75rem 0; }
  .research-row { grid-template-columns: 1fr; gap: 0.35rem; }
  .rn { display: none; }
  .pub-row { grid-template-columns: 1fr; gap: 0.5rem; }
  .pub-meta { flex-direction: row; align-items: center; gap: 0.5rem; }
  .about-grid { grid-template-columns: 1fr; gap: 2.5rem; }
}
</style>
