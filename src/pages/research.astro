---
import Layout from "../layouts/Layout.astro";

const areas = [
  {
    num: "01",
    title: "Intelligent Information Sharing",
    summary: "Modeling how AI teammates should communicate within human-AI teams.",
    desc: `How should AI teammates decide what to share, when to share it, and in what form? This research
    stream investigates information-sharing strategies across different team roles, task contexts, and trust
    conditions. I develop and validate computational models of perceived information need to improve AI
    teammate utility and drive shared situational awareness within the team.`,
    keywords: ["Team Cognition", "Situational Awareness", "AI Communication", "Workload"],
  },
  {
    num: "02",
    title: "Trustworthy AI",
    summary: "Designing AI that calibrates trust, supports repair, and integrates ethical norms.",
    desc: `Trust is foundational to effective human-AI collaboration. My work examines the antecedents and
    consequences of trust in AI teammates, strategies for appropriate calibration, and mechanisms for
    trust repair following violations. I also investigate how AI systems can embody ethical principles
    and how those ethical dimensions shape human acceptance and team performance.`,
    keywords: ["Trust Calibration", "Trust Repair", "AI Ethics", "Transparency"],
  },
  {
    num: "03",
    title: "Shared Mental Models",
    summary: "How humans and AI develop shared knowledge structures for coordination.",
    desc: `Effective teamwork depends on team members sharing compatible mental models of the task,
    teammates, and situation. This research investigates how shared mental models form in human-AI teams,
    how AI agent behavior shapes these representations, and how team cognition can be engineered through
    careful AI design to enhance coordinated performance and adaptability.`,
    keywords: ["Team Cognition", "Coordination", "Mental Models", "Collaboration"],
  },
  {
    num: "04",
    title: "Situational Awareness",
    summary: "How AI presentation and context shape human perception and decision-making.",
    desc: `How team members perceive their environment, teammates, and unfolding events is critical for
    adaptive performance. I examine how AI teammate presentation (anthropomorphism, role framing, spatial
    information), and teammate composition influence human situational awareness, cognitive load, and
    decision-making across applied domains.`,
    keywords: ["Perception", "Cognition", "Anthropomorphism", "Decision-Making"],
  },
  {
    num: "05",
    title: "Applied Human-AI Teaming",
    summary: "Translating teaming science to manufacturing, cybersecurity, and defense.",
    desc: `Basic science must connect to real-world impact. I translate human-AI teaming principles into
    practice across multiple high-stakes domains: advanced manufacturing, cyber threat hunting,
    emergency response coordination, and military command and control. Each domain presents unique
    human factors challenges that advance the broader science.`,
    keywords: ["Manufacturing", "Cybersecurity", "Defense", "Emergency Response"],
  },
  {
    num: "06",
    title: "Evaluation & Validation",
    summary: "Rigorous empirical methods to measure human-AI team performance and trust.",
    desc: `Advancing the science requires robust experimental paradigms and measurement approaches. I develop
    and validate testbeds, task environments, and assessment tools for studying human-AI teams —
    including synthesized task environments, physiological and behavioral measures, mixed-methods
    designs, and computational modeling of team dynamics.`,
    keywords: ["Empirical Methods", "Experimental Design", "Measurement", "Mixed Methods"],
  },
];

const funding = [
  {
    status: "Awarded",
    title: "Preventing, Identifying, and Mitigating the Impact of Compromised AI Teammates Using Shared Situation Awareness and Mental Model Accuracy",
    agency: "Army Research Laboratory (ARL)",
    amount: "$718,690",
    role: "PI (100%)",
  },
  {
    status: "Awarded",
    title: "Understanding the Acceptance of AI Teammates in High-Risk Contexts",
    agency: "University of Tennessee Faculty Research Assistants Funding",
    amount: "$1,750",
    role: "PI (100%)",
  },
  {
    status: "Awarded",
    title: "Developing Personalized Adaptive AI Teammates",
    agency: "University of Tennessee Departmental Research Assistantship Program",
    amount: "$1,750",
    role: "PI (100%)",
  },
  {
    status: "Pending",
    title: "Ethical Shared Mental Models for Adaptive Human-AI Teams: A Novel Framework for Dynamic High-Risk Environments",
    agency: "Army Futures Command (AFC)",
    amount: "$762,778",
    role: "PI (70%)",
  },
  {
    status: "Pending",
    title: "Collaborative Research: Enhancing Team Process Execution Using AI Teammate Augmented Transactive Memory Systems",
    agency: "National Science Foundation (NSF)",
    amount: "$387,256",
    role: "PI (80%)",
  },
];
---

<Layout title="Research" description="Research by Dr. Beau G. Schelble — human-AI teaming, trust, shared mental models, and collaborative intelligent systems.">
  <!-- ── Hero ── -->
  <section class="page-hero">
    <div class="container">
      <p class="section-label">Research</p>
      <h1 class="section-title">Research Overview</h1>
      <p class="section-desc">
        My research advances the science of <strong>human-AI teaming</strong> — understanding how
        humans and intelligent systems can collaborate effectively, safely, and ethically
        across real-world applications.
      </p>
    </div>
  </section>

  <!-- ── Statement ── -->
  <section class="section">
    <div class="container statement-grid">
      <div>
        <p class="section-label">Research Statement</p>
        <h2 class="section-title" style="font-size:1.75rem;">The Human Side of AI</h2>
        <p class="statement-para">
          Modern AI systems are increasingly capable — but capability alone does not make an effective
          teammate. My research investigates the human factors that determine whether humans and AI
          systems can work together productively: trust, communication, shared understanding, and
          adaptive coordination.
        </p>
        <p class="statement-para">
          I employ empirical, mixed-methods approaches combining controlled experiments, behavioral
          and physiological measures, computational modeling, and applied field research. My work is
          grounded in cognitive engineering and human factors theory, and aims to produce both
          fundamental scientific contributions and actionable design guidance for AI developers and operators.
        </p>
        <p class="statement-para">
          Applications span manufacturing, cybersecurity, emergency response, healthcare, and
          military command and control — domains where human-AI teaming quality directly affects
          safety and mission success.
        </p>
      </div>
      <div class="statement-stats">
        <div class="stat-box">
          <span class="stat-big">40+</span>
          <span class="stat-label">Publications</span>
        </div>
        <div class="stat-box">
          <span class="stat-big">$722K</span>
          <span class="stat-label">Funding Awarded (PI)</span>
        </div>
        <div class="stat-box">
          <span class="stat-big">5</span>
          <span class="stat-label">Best Paper Awards</span>
        </div>
        <div class="stat-box">
          <span class="stat-big">~10 yrs</span>
          <span class="stat-label">Research Experience</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Research areas ── -->
  <section class="section-dark">
    <div class="container">
      <p class="section-label">Research Areas</p>
      <h2 class="section-title">Core Focus Areas</h2>
      <div class="areas-list">
        {areas.map(area => (
          <div class="area-item">
            <div class="area-header">
              <span class="area-num">{area.num}</span>
              <div>
                <h3 class="area-title">{area.title}</h3>
                <p class="area-summary">{area.summary}</p>
              </div>
            </div>
            <p class="area-desc">{area.desc}</p>
            <div class="area-keywords">
              {area.keywords.map(kw => (
                <span class="kw-tag">{kw}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Funding ── -->
  <section class="section">
    <div class="container">
      <p class="section-label">Funding</p>
      <h2 class="section-title">Research Grants</h2>
      <p class="section-desc" style="margin-bottom:2.5rem;">
        PI on $722,190 in awarded research funding with additional proposals pending at ARL, NSF, and AFC.
      </p>
      <div class="funding-list">
        {funding.map(f => (
          <div class={`funding-item ${f.status.toLowerCase()}`}>
            <div class="funding-left">
              <span class={`funding-status ${f.status.toLowerCase()}`}>{f.status}</span>
              <span class="funding-amount">{f.amount}</span>
            </div>
            <div class="funding-body">
              <p class="funding-title">{f.title}</p>
              <p class="funding-agency">{f.agency} &nbsp;·&nbsp; {f.role}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── CTA ── -->
  <section class="section-vermillion">
    <div class="container cta-center">
      <h2 class="cta-title">Interested in Collaborating?</h2>
      <p class="cta-desc">
        I welcome inquiries from prospective graduate students, industry partners, and researchers
        interested in human-AI teaming. Visit the ARCS Lab website for current projects and opportunities.
      </p>
      <div class="cta-actions">
        <a href="/contact" class="btn btn-outline-light">Contact Me</a>
        <a href="https://arcslab.io" target="_blank" rel="noopener" class="btn btn-outline-light">Visit ARCS Lab ↗</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-hero {
    padding: 4rem 0 3rem;
    background: var(--light);
    border-bottom: 1px solid var(--border);
  }

  /* Statement */
  .statement-grid {
    display: grid;
    grid-template-columns: 1fr 260px;
    gap: 4rem;
    align-items: start;
  }

  .statement-para {
    font-size: 1rem;
    color: var(--mid);
    line-height: 1.8;
    margin-bottom: 1rem;
  }

  .statement-stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .stat-box {
    background: var(--light);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1.25rem 1rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
  }

  .stat-big {
    font-family: var(--font-display);
    font-size: 1.8rem;
    font-weight: 600;
    color: var(--vermillion);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .stat-label {
    font-size: 0.67rem;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 600;
    text-align: center;
  }

  /* Areas */
  .areas-list { display: flex; flex-direction: column; margin-top: 2.5rem; }

  .area-item {
    padding: 2.5rem 0;
    border-bottom: 1px solid rgba(255,249,244,0.07);
  }

  .area-item:first-child { border-top: 1px solid rgba(255,249,244,0.07); }

  .area-header {
    display: flex;
    gap: 1.5rem;
    align-items: flex-start;
    margin-bottom: 1rem;
  }

  .area-num {
    font-size: 0.65rem;
    font-weight: 800;
    color: var(--gold-light);
    letter-spacing: 0.15em;
    flex-shrink: 0;
    padding-top: 0.25rem;
    min-width: 2ch;
  }

  .area-title {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--cream);
    margin-bottom: 0.25rem;
  }

  .area-summary {
    font-size: 0.85rem;
    color: rgba(255,249,244,0.45);
    font-style: italic;
  }

  .area-desc {
    font-size: 0.9rem;
    color: rgba(255,249,244,0.65);
    line-height: 1.78;
    padding-left: calc(1.5rem + 2ch);
    margin-bottom: 1rem;
  }

  .area-keywords {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    padding-left: calc(1.5rem + 2ch);
  }

  .kw-tag {
    font-size: 0.67rem;
    font-weight: 700;
    padding: 0.2rem 0.6rem;
    border-radius: 3px;
    background: rgba(197,51,32,0.18);
    color: rgba(240,150,120,0.9);
  }

  /* Funding */
  .funding-list { display: flex; flex-direction: column; gap: 0; }

  .funding-item {
    display: flex;
    gap: 2rem;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--border);
    align-items: flex-start;
  }

  .funding-item:first-child { border-top: 1px solid var(--border); }

  .funding-left {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    flex-shrink: 0;
    width: 80px;
    text-align: center;
  }

  .funding-status {
    font-size: 0.62rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    padding: 0.2rem 0.5rem;
    border-radius: 3px;
  }

  .funding-status.awarded {
    background: rgba(197,51,32,0.12);
    color: var(--vermillion-dark);
  }

  .funding-status.pending {
    background: var(--earth-bg);
    color: var(--earth-dark);
  }

  .funding-amount {
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--dark);
  }

  .funding-title {
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--dark);
    line-height: 1.45;
    margin-bottom: 0.3rem;
  }

  .funding-agency {
    font-size: 0.8rem;
    color: var(--muted);
  }

  /* CTA */
  .cta-center {
    text-align: center;
    max-width: 640px;
    margin: 0 auto;
  }

  .cta-title {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 600;
    color: var(--cream);
    margin-bottom: 0.75rem;
  }

  .cta-desc {
    font-size: 1rem;
    color: rgba(255,249,244,0.82);
    line-height: 1.7;
    margin-bottom: 1.75rem;
  }

  .cta-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  @media (max-width: 768px) {
    .statement-grid { grid-template-columns: 1fr; gap: 2rem; }
    .statement-stats { grid-template-columns: repeat(2, 1fr); }
    .area-desc, .area-keywords { padding-left: 0; }
    .funding-item { flex-direction: column; gap: 0.75rem; }
    .funding-left { width: auto; flex-direction: row; }
  }
</style>
